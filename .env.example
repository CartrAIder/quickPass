# Spring Boot 데이터베이스 연결 설정
DB_URL=jdbc:mysql://mysql:3306/quickpass?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=quickpass
DB_PASSWORD=change-this-db-password

# Spring Boot Redis 연결 설정
REDIS_HOST=redis
REDIS_PORT=6379

# JWT 서명 키는 충분히 긴 임의의 값으로 교체한다.
JWT_SECRET=change-this-to-a-long-random-local-jwt-secret-before-running

# Spring Boot가 외부 MinIO에 접속할 때 사용하는 제한된 애플리케이션 계정이다.
MINIO_APP_USER=quickpass-api
MINIO_APP_PASSWORD=change-this-app-password
# cartAider-network 내부 MinIO 주소다. 현재 인프라는 MinIO를 외부에 프록시하지 않는다.
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://minio:9000

# Spring Boot MQTT 클라이언트 연결 설정
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_CLIENT_ID=quickpass-server-local
MQTT_USERNAME=backend
MQTT_PASSWORD=change-this-mqtt-password
