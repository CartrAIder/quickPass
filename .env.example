# MinIO 관리자 자격 증명은 초기화 컨테이너에서만 사용한다.
MINIO_ROOT_USER=quickpass-minio-admin
MINIO_ROOT_PASSWORD=change-this-admin-password

# Spring Boot는 아래의 제한된 애플리케이션 계정만 사용한다.
MINIO_APP_USER=quickpass-api
MINIO_APP_PASSWORD=change-this-app-password
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
